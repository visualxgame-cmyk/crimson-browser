<Window x:Class="CrimsonBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrimsonBrowser"
        xmlns:loc="clr-namespace:CrimsonBrowser.Services"
        xmlns:models="clr-namespace:CrimsonBrowser.Models"
        mc:Ignorable="d"
        Title="{loc:Loc AppTitle}" Icon="crimson.ico" Height="780" Width="1200" MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CrimsonBgDarkBrush}"
        Foreground="{StaticResource TextWhiteBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <!-- Global Key Bindings -->
    <Window.InputBindings>
        <KeyBinding Key="T"  Modifiers="Control"              Command="{Binding NewTabCommand,            RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="W"  Modifiers="Control"              Command="{Binding CloseCurrentTabCommand,   RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="R"  Modifiers="Control"              Command="{Binding RefreshCommand,           RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F5"                                   Command="{Binding RefreshCommand,           RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="L"  Modifiers="Control"              Command="{Binding FocusOmniboxCommand,      RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F12"                                  Command="{Binding OpenDevToolsCommand,      RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="H"  Modifiers="Control"              Command="{Binding OpenHistoryCommand,       RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="N"  Modifiers="Control"              Command="{Binding NewWindowCommand,         RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="N"  Modifiers="Control+Shift"        Command="{Binding OpenIncognitoCommand,     RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="T"  Modifiers="Control+Shift"        Command="{Binding ReopenClosedTabCommand,   RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="B"  Modifiers="Control+Shift"        Command="{Binding ToggleBookmarksBarCommand,RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="D"  Modifiers="Control"              Command="{Binding ToggleBookmarkCommand,    RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F11"                                 Command="{Binding ToggleFullscreenCommand,  RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F"  Modifiers="Control"              Command="{Binding FindCommand,              RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="Tab" Modifiers="Control"             Command="{Binding NextTabCommand,           RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="Tab" Modifiers="Control+Shift"       Command="{Binding PrevTabCommand,           RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="D0" Modifiers="Control"              Command="{Binding ResetZoomCommand,         RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="OemPlus"  Modifiers="Control"        Command="{Binding ZoomInCommand,            RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="OemMinus" Modifiers="Control"        Command="{Binding ZoomOutCommand,           RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Tab strip & title bar -->
            <RowDefinition x:Name="TopBarRow" Height="44" />
            <!-- Row 1: Nav bar & omnibox -->
            <RowDefinition x:Name="NavBarRow" Height="50" />
            <!-- Row 2: Bookmarks bar (collapsible) -->
            <RowDefinition x:Name="BookmarksBarRow" Height="Auto" />
            <!-- Row 3: Find in page bar (collapsible) -->
            <RowDefinition x:Name="FindBarRow" Height="Auto" />
            <!-- Row 4: Web content viewport -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- ROW 0: TOP BAR (LOGO, TABS, WINDOW CONTROLS)                -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Background="#0C0D11" BorderBrush="#1C1D26" BorderThickness="0 0 0 1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Emblem -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14 0 10 0"
                            WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" MouseLeftButtonUp="BrandLogo_Click">
                    <Grid Width="22" Height="22" Margin="0 0 8 0">
                        <Path Fill="{StaticResource CrimsonRedGlowBrush}"
                              Data="M11 1 L20 5 C20 13 16 18 11 21 C6 18 2 13 2 5 Z" />
                        <Path Fill="{StaticResource CrimsonBgDarkBrush}" Margin="2"
                              Data="M9 1 L16 4 C16 10 13 14 9 17 C5 14 2 10 2 4 Z" />
                        <Path Fill="{StaticResource CrimsonRedBrush}" Margin="4"
                              Data="M7 1 L12 4 L7 13 L2 4 Z" />
                    </Grid>
                    <TextBlock Text="CRIMSON" FontSize="13" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Tabs -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="10 4 0 0"
                              WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <ItemsControl x:Name="TabsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:BrowserTab}">
                                    <Border x:Name="TabBorder" Width="180" Height="36" Margin="0 0 3 0"
                                            CornerRadius="8 8 0 0" Cursor="Hand"
                                            Background="#14151C" BorderBrush="#222430" BorderThickness="1 1 1 0"
                                            MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                            MouseMove="Tab_MouseMove"
                                            LostMouseCapture="Tab_LostMouseCapture"
                                            MouseUp="Tab_MouseUp">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{loc:Loc TabDuplicate}" Click="TabContext_Duplicate" />
                                                <MenuItem Header="{loc:Loc TabCopyAddress}" Click="TabContext_CopyUrl" />
                                                <Separator />
                                                <MenuItem Header="{loc:Loc TabClose}" Click="TabContext_Close" />
                                                <MenuItem Header="{loc:Loc TabCloseOthers}" Click="TabContext_CloseOthers" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid Margin="10 0 8 0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{StaticResource CrimsonRedGlowBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding FaviconUrl}" Width="16" Height="16"
                                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="8 0 4 0"
                                                       VerticalAlignment="Center" FontSize="11.5" Foreground="#C9CCD8"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                            <Button Grid.Column="2" Style="{StaticResource CrimsonNavButtonStyle}"
                                                    Width="18" Height="18" FontSize="10" Content="✕"
                                                    Foreground="#707484" Padding="0"
                                                    Click="CloseTab_Click" Tag="{Binding}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#1E202B" />
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource CrimsonRedBrush}" />
                                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="1 2 1 0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter TargetName="TabBorder" Property="Opacity" Value="0.9" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource CrimsonNavButtonStyle}" Width="30" Height="30"
                                Margin="4 0 4 4" VerticalAlignment="Center" ToolTip="{loc:Loc NewTabTooltip}"
                                Click="NewTab_Click">
                            <TextBlock Text="+" FontSize="16" FontWeight="SemiBold" Margin="0 -2 0 0" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CrimsonChromeBtnStyle}" Click="MinimizeBtn_Click" ToolTip="{loc:Loc MinimizeTooltip}">
                        <Path Width="10" Height="2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M0 0 L10 0 L10 2 L0 2 Z" />
                    </Button>
                    <Button x:Name="MaximizeBtn" Style="{StaticResource CrimsonChromeBtnStyle}" Click="MaximizeBtn_Click" ToolTip="{loc:Loc MaximizeTooltip}">
                        <Path x:Name="MaximizeIcon" Width="10" Height="10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" Data="M1 1 L9 1 L9 9 L1 9 Z" />
                    </Button>
                    <Button Style="{StaticResource CrimsonCloseBtnStyle}" Click="CloseBtn_Click" ToolTip="{loc:Loc CloseTooltip}">
                        <Path Width="10" Height="10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Data="M1 1 L9 9 M9 1 L1 9" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- ROW 1: NAVIGATION & OMNIBOX TOOLBAR                         -->
        <!-- ============================================================ -->
        <Border Grid.Row="1" Background="{StaticResource CrimsonBgBarBrush}" BorderBrush="#1C1D26" BorderThickness="0 0 0 1"
                Padding="10 0 10 0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Nav Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0 0 10 0">
                    <Button x:Name="BackBtn" Style="{StaticResource CrimsonNavButtonStyle}" Margin="0 0 3 0"
                            ToolTip="{loc:Loc BackTooltip}" Click="BackBtn_Click">
                        <Path Width="14" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M12 7 L4 7 L8 3 L7 2 L1 8 L7 14 L8 13 L4 9 L12 9 Z" />
                    </Button>
                    <Button x:Name="ForwardBtn" Style="{StaticResource CrimsonNavButtonStyle}" Margin="0 0 3 0"
                            ToolTip="{loc:Loc ForwardTooltip}" Click="ForwardBtn_Click">
                        <Path Width="14" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M2 7 L10 7 L6 3 L7 2 L13 8 L7 14 L6 13 L10 9 L2 9 Z" />
                    </Button>
                    <Button x:Name="ReloadBtn" Style="{StaticResource CrimsonNavButtonStyle}" Margin="0 0 3 0"
                            ToolTip="{loc:Loc ReloadTooltip}" Click="ReloadBtn_Click">
                        <Path x:Name="ReloadIcon" Width="14" Height="14"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Data="M7 1 A6 6 0 1 1 2 7 M7 1 L4 4 M7 1 L10 4" />
                    </Button>
                    <Button Style="{StaticResource CrimsonNavButtonStyle}" Margin="0 0 3 0"
                            ToolTip="{loc:Loc HomeTooltip}" Click="HomeBtn_Click">
                        <Path Width="14" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M7 1 L1 6 L2 7 L3 7 L3 13 L6 13 L6 9 L8 9 L8 13 L11 13 L11 7 L12 7 L13 6 Z" />
                    </Button>
                </StackPanel>

                <!-- Omnibox -->
                <Border Grid.Column="1" x:Name="OmniboxBorder" Background="#1A1C25" BorderBrush="#2C2F3E"
                        BorderThickness="1" CornerRadius="18" Height="36" Padding="12 0 10 0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Lock / Security Icon -->
                        <Path Grid.Column="0" x:Name="SecurityIcon" Width="12" Height="12" Margin="0 0 10 0"
                              Fill="#8E92A4" VerticalAlignment="Center"
                              Data="M6 1 C4.3 1 3 2.3 3 4 L3 5 L2 5 C1.4 5 1 5.4 1 6 L1 11 C1 11.6 1.4 12 2 12 L10 12 C10.6 12 11 11.6 11 11 L11 6 C11 5.4 10.6 5 10 5 L9 5 L9 4 C9 2.3 7.7 1 6 1 Z M4.5 4 C4.5 3.2 5.2 2.5 6 2.5 C6.8 2.5 7.5 3.2 7.5 4 L7.5 5 L4.5 5 Z" />

                        <!-- URL TextBox -->
                        <TextBox Grid.Column="1" x:Name="OmniboxTextBox" Background="Transparent" BorderThickness="0"
                                 Foreground="White" FontSize="12.5" VerticalAlignment="Center"
                                 CaretBrush="{StaticResource CrimsonRedGlowBrush}"
                                 KeyDown="OmniboxTextBox_KeyDown"
                                 GotFocus="OmniboxTextBox_GotFocus"
                                 LostFocus="OmniboxTextBox_LostFocus" />

                        <!-- Placeholder -->
                        <TextBlock Grid.Column="1" x:Name="OmniboxPlaceholder" Text="{loc:Loc OmniboxPlaceholder}"
                                   Foreground="#686C7E" FontSize="12.5" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Margin="2 0 0 0" />

                        <!-- Bookmark Star Button -->
                        <Button Grid.Column="2" x:Name="BookmarkStarBtn" Style="{StaticResource CrimsonNavButtonStyle}"
                                Width="26" Height="26" ToolTip="{loc:Loc BookmarkTooltip}"
                                Click="BookmarkStar_Click">
                            <TextBlock x:Name="BookmarkStarText" Text="☆" FontSize="14"
                                       Foreground="#686C7E" VerticalAlignment="Center" />
                        </Button>

                        <!-- Go / Navigate Button -->
                        <Button Grid.Column="3" Style="{StaticResource CrimsonNavButtonStyle}" Width="26" Height="26"
                                ToolTip="{loc:Loc NavigateTooltip}" Click="GoBtn_Click">
                            <Path Width="10" Height="10" Fill="{StaticResource CrimsonRedGlowBrush}"
                                  Data="M1 5 L7 5 L5 2 L6 1 L10 5 L6 9 L5 8 L7 5 Z" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10 0 0 0">
                    <!-- Crimson Shields Button -->
                    <Border x:Name="ShieldsBtnBorder" Background="#251219" BorderBrush="{StaticResource CrimsonDarkRedBrush}"
                            BorderThickness="1" CornerRadius="15" Height="30" Padding="8 0 10 0"
                            Cursor="Hand" ToolTip="{loc:Loc ShieldsTooltip}"
                            MouseLeftButtonUp="ShieldsBtn_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="ShieldBtnIcon" Width="12" Height="12" Fill="{StaticResource CrimsonRedGlowBrush}" Margin="0 0 6 0"
                                  Data="M6 0 L12 2.5 C12 7.5 9 10.5 6 12 C3 10.5 0 7.5 0 2.5 Z" />
                            <TextBlock x:Name="ShieldBtnText" Text="SHIELDS" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{StaticResource CrimsonRedGlowBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Downloads Button -->
                    <Button x:Name="DownloadsBtn" Style="{StaticResource CrimsonNavButtonStyle}" Margin="8 0 2 0"
                            ToolTip="{loc:Loc DownloadsTooltip}" Click="DownloadsBtn_Click">
                        <Grid>
                            <TextBlock Text="⬇" FontSize="13" Foreground="#8E92A4" />
                            <Border x:Name="DownloadsBadge" Background="{StaticResource CrimsonRedBrush}"
                                    CornerRadius="6" Width="12" Height="12"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 -2 -2 0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="DownloadsBadgeText" Text="0" FontSize="8" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- DevTools Button -->
                    <Button Style="{StaticResource CrimsonNavButtonStyle}" Margin="2 0 2 0"
                            ToolTip="{loc:Loc DevToolsTooltip}" Click="OpenDevTools_Click">
                        <TextBlock Text="&lt;/&gt;" FontSize="11" FontWeight="Bold" Foreground="#8E92A4" />
                    </Button>

                    <!-- Menu Button (⋮) -->
                    <Button x:Name="MenuBtn" Style="{StaticResource CrimsonNavButtonStyle}" Margin="2 0 0 0"
                            ToolTip="{loc:Loc MenuTooltip}" Click="MenuBtn_Click">
                        <TextBlock Text="⋮" FontSize="16" FontWeight="Bold" Foreground="#8E92A4" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- ROW 2: BOOKMARKS BAR (toggleable, hidden by default)        -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" x:Name="BookmarksBarBorder" Background="#0F1018" BorderBrush="#1C1D26"
                BorderThickness="0 0 0 1" Padding="10 4" Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="BookmarksBarItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CrimsonNavButtonStyle}" Margin="0 0 4 0"
                                    Height="26" Padding="8 0"
                                    ToolTip="{Binding Url}"
                                    Click="BookmarkBarItem_Click"
                                    Tag="{Binding}">
                                <TextBlock Text="{Binding Title}" FontSize="11.5" Foreground="#C9CCD8"
                                           MaxWidth="130" TextTrimming="CharacterEllipsis" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ============================================================ -->
        <!-- ROW 3: WEB CONTENT VIEWPORT                                 -->
        <!-- ============================================================ -->
        <Grid Grid.Row="4" Background="{StaticResource CrimsonBgDarkBrush}" x:Name="WebContainer" />

        <!-- ============================================================ -->
        <!-- FLOATING: CRIMSON SHIELDS POPUP                             -->
        <!-- ============================================================ -->
        <Popup x:Name="ShieldsPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
            <Border Background="#161720" BorderBrush="{StaticResource CrimsonDarkRedBrush}"
                    BorderThickness="1.5" CornerRadius="14" Padding="18" Width="330" Margin="0 10 0 0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Color="#000000" Opacity="0.85" />
                </Border.Effect>
                <StackPanel>
                    <!-- Header with Master Toggle -->
                    <Grid Margin="0 0 0 14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="PopupShieldIcon" Width="22" Height="22" Fill="{StaticResource CrimsonRedGlowBrush}" Margin="0 0 10 0"
                                  Data="M10 0 L20 4 C20 13 15 18 10 20 C5 18 0 13 0 4 Z" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc ShieldsTitle}" FontWeight="Bold" FontSize="14.5" Foreground="White" />
                                <TextBlock x:Name="ShieldsStatusSubtext" Text="{loc:Loc ShieldsActive}" FontSize="11"
                                           Foreground="{StaticResource CrimsonRedGlowBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="MasterShieldToggle" Style="{StaticResource CrimsonToggleStyle}"
                                      VerticalAlignment="Center" Click="MasterShieldToggle_Click" />
                    </Grid>

                    <!-- Blocked Count Banner -->
                    <Border Background="#201117" BorderBrush="#3D1823" BorderThickness="1" CornerRadius="8"
                            Padding="12 8" Margin="0 0 0 14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛡️" FontSize="13" Margin="0 0 6 0" />
                                <TextBlock x:Name="BlockedStatsText" Text="0" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#FF5577" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource CrimsonNavButtonStyle}" Width="22" Height="22"
                                    ToolTip="{loc:Loc ResetStatsTooltip}" Click="ResetBlockedStats_Click">
                                <TextBlock Text="↺" FontSize="12" Foreground="#8E92A4" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Individual Toggles -->
                    <StackPanel x:Name="ShieldOptionsPanel">
                        <Grid Margin="0 0 0 12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0 0 10 0">
                                <TextBlock Text="{loc:Loc BlockAdsTitle}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="{loc:Loc BlockAdsDesc}" FontSize="10" Foreground="#8E92A4" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="ToggleAds" Style="{StaticResource CrimsonToggleStyle}"
                                          VerticalAlignment="Center" Click="ToggleAds_Click" />
                        </Grid>

                        <Grid Margin="0 0 0 12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0 0 10 0">
                                <TextBlock Text="{loc:Loc LowRamTitle}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="{loc:Loc LowRamDesc}" FontSize="10" Foreground="#8E92A4" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="ToggleLowRam" Style="{StaticResource CrimsonToggleStyle}"
                                          VerticalAlignment="Center" Click="ToggleLowRam_Click" />
                        </Grid>

                        <Grid Margin="0 0 0 12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0 0 10 0">
                                <TextBlock Text="{loc:Loc HttpsTitle}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="{loc:Loc HttpsDesc}" FontSize="10" Foreground="#8E92A4" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="ToggleHttps" Style="{StaticResource CrimsonToggleStyle}"
                                          VerticalAlignment="Center" Click="ToggleHttps_Click" />
                        </Grid>

                        <Grid Margin="0 0 0 6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0 0 10 0">
                                <TextBlock Text="{loc:Loc PopupsTitle}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="{loc:Loc PopupsDesc}" FontSize="10" Foreground="#8E92A4" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="TogglePopups" Style="{StaticResource CrimsonToggleStyle}"
                                          VerticalAlignment="Center" Click="TogglePopups_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ============================================================ -->
        <!-- FLOATING: DOWNLOADS FLYOUT POPUP                            -->
        <!-- ============================================================ -->
        <Popup x:Name="DownloadsPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=DownloadsBtn}" HorizontalOffset="-170">
            <Border Background="#161720" BorderBrush="#2C2F40" BorderThickness="1"
                    CornerRadius="12" Padding="10" Width="320" Margin="0 8 0 0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Color="#000000" Opacity="0.85" />
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="6 4 6 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc DownloadsHeader}" FontWeight="Bold" FontSize="13" Foreground="White" />
                        <Button Grid.Column="1" Style="{StaticResource CrimsonNavButtonStyle}" Height="24" Padding="8 0"
                                FontSize="11" Click="ClearCompletedDownloads_Click">
                            <TextBlock Text="{loc:Loc DownloadsClearCompleted}" Foreground="#8E92A4" />
                        </Button>
                    </Grid>

                    <!-- Downloads List -->
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DownloadsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1C1D27" CornerRadius="8" Padding="10 8" Margin="0 0 0 6">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Filename}" Foreground="White"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#8E92A4"
                                                           FontSize="11" VerticalAlignment="Center" Margin="8 0 0 0" />
                                            </Grid>
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4"
                                                         Margin="0 6 0 0" Background="#252636"
                                                         Foreground="{StaticResource CrimsonRedGlowBrush}"
                                                         BorderThickness="0" />
                                             <StackPanel Orientation="Horizontal" Margin="0 7 0 0">
                                                 <Button Style="{StaticResource CrimsonNavButtonStyle}" Height="24" Width="Auto" Padding="8 0"
                                                         Click="OpenDownloadedFile_Click" IsEnabled="{Binding IsCompleted}">
                                                     <TextBlock Text="{loc:Loc DownloadsOpenFile}" FontSize="10.5" Foreground="#D1D4DC" />
                                                 </Button>
                                                 <Button Style="{StaticResource CrimsonNavButtonStyle}" Height="24" Width="Auto" Padding="8 0" Margin="6 0 0 0"
                                                         Click="OpenDownloadFolder_Click">
                                                     <TextBlock Text="{loc:Loc DownloadsOpenFolder}" FontSize="10.5" Foreground="#D1D4DC" />
                                                 </Button>
                                             </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state -->
                    <Button Style="{StaticResource CrimsonMenuItemStyle}" Click="ReviewDownloadWarnings_Click" Margin="0 6 0 0">
                        <TextBlock Text="{loc:Loc DownloadsReviewWarnings}" TextWrapping="Wrap" />
                    </Button>
                    <TextBlock x:Name="NoDownloadsText" Text="{loc:Loc NoDownloads}" Foreground="#545870"
                               FontSize="12" HorizontalAlignment="Center" Margin="0 10" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- ============================================================ -->
        <!-- FLOATING: THREE-DOTS MENU POPUP                             -->
        <!-- ============================================================ -->
        <Popup x:Name="MenuPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=MenuBtn}" HorizontalOffset="-206">
            <Border Background="#161720" BorderBrush="#2C2F40" BorderThickness="1"
                    CornerRadius="12" Padding="8" Width="260" Margin="0 8 0 0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Color="#000000" Opacity="0.85" />
                </Border.Effect>
                <StackPanel>
                    <!-- New Tab -->
                    <Button Style="{StaticResource CrimsonMenuItemStyle}" Click="MenuNewTab_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc MenuNewTab}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Ctrl+T" Foreground="#777B8E" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- New Window -->
                    <Button Style="{StaticResource CrimsonMenuItemStyle}" Click="MenuNewWindow_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc MenuNewWindow}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Ctrl+N" Foreground="#777B8E" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- New Incognito Window -->
                    <Button Style="{StaticResource CrimsonMenuItemStyle}" Click="MenuIncognito_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🕶️" Margin="0 0 6 0" FontSize="12" />
                                <TextBlock Text="{loc:Loc MenuIncognito}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Ctrl+Shift+N" Foreground="#777B8E" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Reopen Closed Tab -->
                    <Button Style="{StaticResource CrimsonMenuItemStyle}" Click="MenuReopenTab_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc MenuReopenTab}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Ctrl+Shift+T" Foreground="#777B8E" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Separator Background="#262838" Margin="4 6" />

                    <!-- History -->
                    <Button x:Name="MenuHistoryBtn" Style="{StaticResource CrimsonMenuItemStyle}" Click="MenuHistory_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc MenuHistory}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Ctrl+H" Foreground="#777B8E" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Find on page -->
                    <Button Style="{StaticResource CrimsonMenuItemStyle}" Click="MenuFind_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc MenuFind}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Ctrl+F" Foreground="#777B8E" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Fullscreen -->
                    <Button Style="{StaticResource CrimsonMenuItemStyle}" Click="MenuFullscreen_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc MenuFullscreen}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="F11" Foreground="#777B8E" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Bookmarks Bar Toggle -->
                    <Button Style="{StaticResource CrimsonMenuItemStyle}" Click="MenuToggleBookmarksBar_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc MenuBookmarksBar}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Ctrl+Shift+B" Foreground="#777B8E" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Downloads -->
                    <Button Style="{StaticResource CrimsonMenuItemStyle}" Click="MenuDownloads_Click">
                        <TextBlock Text="{loc:Loc MenuDownloads}" VerticalAlignment="Center" />
                    </Button>

                    <Separator Background="#262838" Margin="4 6" />

                    <!-- Zoom -->
                    <Border Background="#1C1D27" CornerRadius="8" Padding="10 6" Margin="0 2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc MenuZoom}" Foreground="#D8DBE5" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource CrimsonNavButtonStyle}" Width="26" Height="26"
                                        ToolTip="{loc:Loc ZoomOut}" Click="MenuZoomOut_Click">
                                    <TextBlock Text="-" FontSize="14" FontWeight="Bold" />
                                </Button>
                                <TextBlock x:Name="MenuZoomText" Text="100%" Width="46" TextAlignment="Center"
                                           FontSize="11.5" Foreground="White" VerticalAlignment="Center" />
                                <Button Style="{StaticResource CrimsonNavButtonStyle}" Width="26" Height="26"
                                        ToolTip="{loc:Loc ZoomIn}" Click="MenuZoomIn_Click">
                                    <TextBlock Text="+" FontSize="14" FontWeight="Bold" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Separator Background="#262838" Margin="4 6" />

                    <!-- DevTools -->
                    <Button Style="{StaticResource CrimsonMenuItemStyle}" Click="MenuDevTools_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc MenuDevTools}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="F12" Foreground="#777B8E" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Clear Data -->
                    <Button Style="{StaticResource CrimsonMenuItemStyle}" Click="MenuClearData_Click">
                        <TextBlock x:Name="MenuClearDataText" Text="{loc:Loc MenuClearData}" VerticalAlignment="Center" />
                    </Button>

                    <Separator Background="#262838" Margin="4 6" />

                    <!-- Settings -->
                    <Button x:Name="MenuSettingsBtn" Style="{StaticResource CrimsonMenuItemStyle}" Click="MenuSettings_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="MenuSettingsText" Text="{loc:Loc MenuSettings}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="⚙️" FontSize="12" VerticalAlignment="Center" Margin="10 0 0 0" />
                        </Grid>
                    </Button>

                    <!-- Set as default browser -->
                    <Button x:Name="MenuDefaultBrowserBtn" Style="{StaticResource CrimsonMenuItemStyle}" Click="MenuDefaultBrowser_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="MenuDefaultBrowserText" Text="{loc:Loc MenuDefaultBrowser}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="MenuDefaultBrowserHint" Text="{loc:Loc MenuDefaultBrowserHint}" Foreground="#777B8E"
                                       FontSize="11" VerticalAlignment="Center" Margin="10 0 0 0" />
                        </Grid>
                    </Button>

                    <!-- About -->
                    <Button x:Name="MenuAboutBtn" Style="{StaticResource CrimsonMenuItemStyle}" Click="MenuAbout_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="MenuAboutText" Text="{loc:Loc MenuAbout}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="v1.0" Foreground="{StaticResource CrimsonRedGlowBrush}"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10 0 0 0" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ============================================================ -->
        <!-- ROW 3: FIND IN PAGE BAR                                     -->
        <!-- ============================================================ -->
        <Border x:Name="FindBar" Grid.Row="3" Visibility="Collapsed"
                Background="#13141B" BorderBrush="#1C1D26" BorderThickness="0 0 0 1"
                Padding="12 5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{loc:Loc FindOnPage}" Foreground="#8E92A4" FontSize="11.5"
                           VerticalAlignment="Center" Margin="0 0 10 0" />
                <TextBox x:Name="FindTextBox" Width="230" Height="28"
                         Background="#1A1C25" Foreground="White" BorderThickness="0"
                         Padding="8 0" VerticalContentAlignment="Center" FontSize="12"
                         CaretBrush="{StaticResource CrimsonRedGlowBrush}"
                         TextChanged="FindTextBox_TextChanged"
                         KeyDown="FindTextBox_KeyDown" />
                <TextBlock x:Name="FindMatchText" Text="0/0" Width="52" TextAlignment="Center"
                           Foreground="#8E92A4" FontSize="11" VerticalAlignment="Center" Margin="4 0" />
                <Button Style="{StaticResource CrimsonNavButtonStyle}" Width="28" Height="28"
                        ToolTip="{loc:Loc FindPrevious}" Click="FindPrev_Click">
                    <TextBlock Text="↑" FontSize="13" Foreground="#C9CCD8" />
                </Button>
                <Button Style="{StaticResource CrimsonNavButtonStyle}" Width="28" Height="28"
                        ToolTip="{loc:Loc FindNext}" Click="FindNext_Click">
                    <TextBlock Text="↓" FontSize="13" Foreground="#C9CCD8" />
                </Button>
                <Button Style="{StaticResource CrimsonNavButtonStyle}" Width="28" Height="28"
                        ToolTip="{loc:Loc FindClose}" Click="FindClose_Click">
                    <TextBlock Text="✕" FontSize="11" Foreground="#8E92A4" />
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</Window>
