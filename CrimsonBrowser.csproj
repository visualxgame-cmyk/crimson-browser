<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>Crimson Browser</ApplicationTitle>
    <AssemblyName>CrimsonBrowser</AssemblyName>
    <RootNamespace>CrimsonBrowser</RootNamespace>
    <ApplicationIcon>crimson.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="crimson.ico" />
    <Content Include="crimson.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\startpage.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
