<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>CrimsonBrowser.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <CefSharpExcludeSubProcessExe>true</CefSharpExcludeSubProcessExe>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <!-- This CEF/V8 build does not support CET shadow stacks. The .NET 10
         apphost default otherwise terminates self-hosted renderers during JIT. -->
    <CETCompat>false</CETCompat>
    <ApplicationTitle>Crimson Browser</ApplicationTitle>
    <AssemblyName>CrimsonBrowser</AssemblyName>
    <RootNamespace>CrimsonBrowser</RootNamespace>
    <ApplicationIcon>crimson.ico</ApplicationIcon>
    <Version>1.1.13</Version>
    <Product>Crimson Browser</Product>
    <AssemblyTitle>Crimson Browser</AssemblyTitle>
    <Company>VisualX Studio</Company>
    <Description>A fast, low-memory Chromium browser with Crimson Shields privacy protection.</Description>
    <Copyright>Copyright © 2026 VisualX Studio</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;dist\**;publish\**;tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="crimson.ico" />
    <Content Include="crimson.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.Wpf.NETCore" Version="156.0.150" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Licenses\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Resources\Install-Update.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\startpage.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Test sources are compiled only by their dedicated project, never by the WPF executable. -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

</Project>
