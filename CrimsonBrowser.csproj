<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>Crimson Browser</ApplicationTitle>
    <AssemblyName>CrimsonBrowser</AssemblyName>
    <RootNamespace>CrimsonBrowser</RootNamespace>
    <ApplicationIcon>crimson.ico</ApplicationIcon>
    <Version>1.0.6</Version>
    <Product>Crimson Browser</Product>
    <AssemblyTitle>Crimson Browser</AssemblyTitle>
    <Company>VisualX Studio</Company>
    <Description>A fast, low-memory Chromium browser with Crimson Shields privacy protection.</Description>
    <Copyright>Copyright © 2026 VisualX Studio</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="crimson.ico" />
    <Content Include="crimson.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\Install-Update.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\startpage.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Test sources are compiled only by their dedicated project, never by the WPF executable. -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

</Project>
