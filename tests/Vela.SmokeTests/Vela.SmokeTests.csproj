<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Vela.SmokeTests</AssemblyName>
    <StartupObject>Vela.Tests.Program</StartupObject>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <!-- Compile the actual application against an isolated data directory. -->
    <Compile Include="../../src/Vela/**/*.cs" Exclude="../../src/Vela/bin/**;../../src/Vela/obj/**;../../src/Vela/App.xaml.cs;../../src/Vela/Services/AppPaths.cs" LinkBase="Application" />
    <Page Include="../../src/Vela/*Window.xaml" Link="%(Filename)%(Extension)" />
    <Page Include="../../src/Vela/Theme/Theme.xaml" Link="Theme/Theme.xaml" />
    <Resource Include="../../src/Vela/Assets/vela.ico" Link="Assets/vela.ico" />
    <Content Include="../../src/Vela/Assets/**/*" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
