<Window x:Class="CrimsonBrowser.CrimsonPermissionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CrimsonBrowser.Services"
        Title="{loc:Loc PermissionTitle}"
        Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextWhiteBrush}">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C9CCD8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    Background="#1A1C25" BorderBrush="#3A3D50" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M3 8 L6.5 11.5 L13 4"
                                      Stroke="White" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="9 0 0 0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E61937" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF3355" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF3355" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#161720" BorderBrush="{StaticResource CrimsonDarkRedBrush}" BorderThickness="1.5"
            CornerRadius="16" Padding="24" Margin="12"
            MouseLeftButtonDown="Shell_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Color="#000000" Opacity="0.9" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0 0 0 16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#251219"
                        BorderBrush="{StaticResource CrimsonDarkRedBrush}" BorderThickness="1"
                        VerticalAlignment="Center" Margin="0 0 12 0">
                    <Path Width="18" Height="18" Fill="{StaticResource CrimsonRedGlowBrush}"
                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M9 0 L18 4 C18 12 14 17 9 18 C4 17 0 12 0 4 Z" />
                </Border>

                <TextBlock Grid.Column="1" Text="{loc:Loc PermissionTitle}"
                           FontSize="15" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <Button Grid.Column="2" Style="{StaticResource CrimsonNavButtonStyle}" Width="28" Height="28"
                        Click="Block_Click" ToolTip="{loc:Loc CloseTooltip}">
                    <TextBlock Text="✕" FontSize="12" Foreground="#8E92A4" />
                </Button>
            </Grid>

            <!-- Site + request -->
            <StackPanel Grid.Row="1" Margin="2 0 2 18">
                <TextBlock x:Name="OriginText" Text="example.com"
                           Foreground="{StaticResource CrimsonRedGlowBrush}"
                           FontSize="13.5" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="RequestText" Text="wants to use your microphone."
                           Foreground="#C9CCD8" FontSize="12.5" TextWrapping="Wrap"
                           LineHeight="19" Margin="0 6 0 0" />
            </StackPanel>

            <!-- Remember -->
            <CheckBox Grid.Row="2" x:Name="RememberCheck" Margin="2 0 2 20"
                      Content="{loc:Loc PermissionRemember}" />

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CrimsonNavButtonStyle}"
                        Width="Auto" Height="34" Padding="18 0" Margin="0 0 10 0"
                        Background="#222432" Click="Block_Click">
                    <TextBlock Text="{loc:Loc PermissionBlock}" FontSize="12" FontWeight="SemiBold" Foreground="#C9CCD8" />
                </Button>
                <Button Style="{StaticResource CrimsonNavButtonStyle}"
                        Width="Auto" Height="34" Padding="20 0"
                        Background="#E61937" Click="Allow_Click">
                    <TextBlock Text="{loc:Loc PermissionAllow}" FontSize="12" FontWeight="Bold" Foreground="White" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
