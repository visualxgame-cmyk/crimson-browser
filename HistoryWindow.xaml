<Window x:Class="CrimsonBrowser.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:CrimsonBrowser.Services"
        mc:Ignorable="d"
        Title="{loc:Loc HistoryWindowTitle}" Height="560" Width="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="#161720" BorderBrush="{StaticResource CrimsonDarkRedBrush}" BorderThickness="1.5"
            CornerRadius="16" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Color="#000000" Opacity="0.85" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="54" />
                <!-- Search bar -->
                <RowDefinition Height="52" />
                <!-- List -->
                <RowDefinition Height="*" />
                <!-- Footer -->
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="#111218" CornerRadius="15 15 0 0" Padding="18 0"
                    BorderBrush="#252736" BorderThickness="0 0 0 1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🕐" FontSize="16" Margin="0 0 10 0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Loc HistoryTitle}" FontSize="15" FontWeight="Bold" Foreground="White"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource CrimsonNavButtonStyle}" Width="30" Height="30"
                            Click="Close_Click" ToolTip="{loc:Loc CloseTooltip}">
                        <TextBlock Text="✕" FontSize="13" Foreground="#8E92A4" />
                    </Button>
                </Grid>
            </Border>

            <!-- SEARCH BAR -->
            <Border Grid.Row="1" Padding="14 8" BorderBrush="#1C1D26" BorderThickness="0 0 0 1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#1A1C25" BorderBrush="#2C2F3E" BorderThickness="1"
                            CornerRadius="14" Height="34" Padding="10 0">
                        <Grid>
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                     Foreground="White" FontSize="12" VerticalAlignment="Center"
                                     CaretBrush="{StaticResource CrimsonRedGlowBrush}"
                                     TextChanged="SearchBox_TextChanged" />
                            <TextBlock x:Name="SearchPlaceholder" Text="{loc:Loc HistorySearch}" Foreground="#686C7E"
                                       FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2 0 0 0" />
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource CrimsonNavButtonStyle}" Margin="8 0 0 0"
                            Height="34" Padding="12 0" Click="ClearAll_Click"
                            Background="#251219" BorderBrush="{StaticResource CrimsonDarkRedBrush}" BorderThickness="1">
                        <TextBlock Text="{loc:Loc HistoryClearAll}" Foreground="{StaticResource CrimsonRedGlowBrush}" FontSize="11.5" FontWeight="SemiBold" />
                    </Button>
                </Grid>
            </Border>

            <!-- HISTORY LIST -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8 4">
                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" BorderBrush="#1E2030" BorderThickness="0 0 0 1"
                                    Padding="12 10" Cursor="Hand"
                                    MouseLeftButtonUp="HistoryItem_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A1C26" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="12.5"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Url}" Foreground="#6A6E82" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" Margin="0 2 0 0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding VisitedAt, StringFormat='{}{0:MMM d, HH:mm}'}"
                                               Foreground="#545870" FontSize="11" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- FOOTER -->
            <Border Grid.Row="3" Background="#111218" CornerRadius="0 0 15 15" Padding="14 0"
                    BorderBrush="#252736" BorderThickness="0 1 0 0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="EntryCountText" Text="" Foreground="#545870" FontSize="11"
                               VerticalAlignment="Center" Margin="0 0 16 0" />
                    <Button Style="{StaticResource CrimsonNavButtonStyle}" Width="110" Height="34"
                            Background="#E61937" Click="Close_Click">
                        <TextBlock Text="{loc:Loc HistoryClose}" FontWeight="Bold" Foreground="White" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
