<Window x:Class="CrimsonBrowser.CrimsonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crimson Browser"
        Width="430" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextWhiteBrush}">

    <Border Background="#161720" BorderBrush="{StaticResource CrimsonDarkRedBrush}" BorderThickness="1.5"
            CornerRadius="16" Padding="24" Margin="12"
            MouseLeftButtonDown="Shell_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Color="#000000" Opacity="0.9" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0 0 0 14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#251219"
                        BorderBrush="{StaticResource CrimsonDarkRedBrush}" BorderThickness="1"
                        VerticalAlignment="Center" Margin="0 0 12 0">
                    <Path x:Name="DialogIcon" Width="18" Height="18" Fill="{StaticResource CrimsonRedGlowBrush}"
                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M9 0 L18 4 C18 12 14 17 9 18 C4 17 0 12 0 4 Z" />
                </Border>

                <TextBlock Grid.Column="1" x:Name="TitleText" Text="Crimson Browser"
                           FontSize="15" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <Button Grid.Column="2" Style="{StaticResource CrimsonNavButtonStyle}" Width="28" Height="28"
                        Click="Cancel_Click" ToolTip="Close">
                    <TextBlock Text="✕" FontSize="12" Foreground="#8E92A4" />
                </Button>
            </Grid>

            <!-- Message -->
            <TextBlock Grid.Row="1" x:Name="MessageText" Text="Message"
                       Foreground="#C9CCD8" FontSize="12.5" TextWrapping="Wrap"
                       LineHeight="19" Margin="2 0 2 22" />

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Style="{StaticResource CrimsonNavButtonStyle}"
                        Width="Auto" Height="34" Padding="18 0" Margin="0 0 10 0"
                        Background="#222432" Click="Cancel_Click">
                    <TextBlock x:Name="CancelText" Text="Cancel" FontSize="12" FontWeight="SemiBold"
                               Foreground="#C9CCD8" />
                </Button>
                <Button x:Name="OkBtn" Style="{StaticResource CrimsonNavButtonStyle}"
                        Width="Auto" Height="34" Padding="20 0"
                        Background="#E61937" Click="Ok_Click">
                    <TextBlock x:Name="OkText" Text="OK" FontSize="12" FontWeight="Bold"
                               Foreground="White" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
