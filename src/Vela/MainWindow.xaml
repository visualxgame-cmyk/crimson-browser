<Window x:Class="Vela.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Vela"
        Icon="Assets/vela.ico"
        Height="860" Width="1380" MinHeight="520" MinWidth="760"
        WindowStyle="None" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- ================= TAB STRIP ================= -->
        <Grid Grid.Row="0" Background="{DynamicResource WindowBg}"
              MouseLeftButtonDown="TabStrip_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="TabScroll" Grid.Column="0"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          PanningMode="HorizontalOnly"
                          Margin="4,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl x:Name="TabItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabBorder" Width="{Binding DisplayWidth}" Height="32" Margin="0,4,2,0"
                                        CornerRadius="9,9,4,4" Background="Transparent"
                                        MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                        MouseDown="Tab_MouseDown"
                                        PreviewMouseLeftButtonDown="Tab_DragMouseDown" MouseMove="Tab_MouseMove" ContextMenuOpening="Tab_ContextMenuOpening"
                                        ToolTip="{Binding Title}">
                                    <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HeaderVisible}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource TabHoverBg}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource TabActiveBg}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid Margin="9,0,5,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- favicon / fallback glyph -->
                                        <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Source="{Binding Favicon}" Width="16" Height="16"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>

                                        <Button Grid.Column="0" Content="&#xE767;" Width="18" Height="20" FontSize="12" Click="Audio_Click" ToolTip="Activează / oprește sunetul tabului">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAudible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True"><Setter Property="Visibility" Value="Visible" /><Setter Property="Content" Value="&#xE74F;" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <DockPanel x:Name="TabTitlePanel" Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                            <Ellipse DockPanel.Dock="Right" Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="5,0,0,0"
                                                     ToolTip="Modificări nesalvate — tab protejat de eliberarea automată">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis"><Run Text="{Binding GroupPrefix}" Foreground="{DynamicResource Accent}" /><Run Text="{Binding Title}" /></TextBlock>
                                        </DockPanel>

                                        <Button x:Name="TabClose" Grid.Column="2" Content="&#xE8BB;"
                                                Style="{StaticResource IconButton}" Width="20" Height="20"
                                                FontSize="9" Opacity="0" Click="TabClose_Click"
                                                ToolTip="Închide tabul" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter TargetName="TabTitlePanel" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=TabBorder}" Value="True">
                                        <Setter TargetName="TabClose" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="TabClose" Property="Opacity" Value="0.7" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- new tab -->
                    <Button x:Name="NewTabButton" Content="&#xE710;" Style="{StaticResource IconButton}"
                            Width="28" Height="28" Margin="4,5,0,0" FontSize="12"
                            ToolTip="Tab nou (Ctrl+T)" Click="NewTabButton_Click" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock x:Name="PrivateBadge" Text="PRIVAT" Visibility="Collapsed" FontSize="10" Foreground="{DynamicResource Accent}" Margin="6,12,6,0" ToolTip="Istoricul și sesiunea acestei ferestre nu sunt salvate. Descărcările și favoritele salvate rămân pe disc." />
                <Button x:Name="ProfileButton" Style="{StaticResource MenuRowButton}" Content="Principal" Tag="profiles" Click="Workspace_Click" MaxWidth="120" Height="32" Margin="4,0,4,0" ToolTip="Profilul activ — deschide profilurile" />
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimizare" Click="Minimize_Click" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximizare" Click="Maximize_Click" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Închidere" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- ================= TOOLBAR + BOOKMARKS BAR ================= -->
        <StackPanel Grid.Row="1">
        <Border Background="{DynamicResource ToolbarBg}" Padding="8,2,8,6"
                MouseLeftButtonDown="TabStrip_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- navigation cluster -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;"
                            FontSize="15" ToolTip="Înapoi (Alt+&#x2190;)" Click="Back_Click" />
                    <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;"
                            FontSize="15" ToolTip="Înainte (Alt+&#x2192;)" Click="Forward_Click" />
                    <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                            FontSize="14" ToolTip="Reîncarcă (F5)" Click="Reload_Click" />
                    <Button x:Name="HomeButton" Style="{StaticResource IconButton}" Content="&#xE80F;"
                            FontSize="14" ToolTip="Pagina de start" Click="Home_Click" />
                </StackPanel>

                <!-- omnibox -->
                <Border Grid.Column="1" x:Name="OmniboxBorder" Height="34" Margin="8,2"
                        CornerRadius="9" Background="{DynamicResource OmniboxBg}"
                        BorderBrush="Transparent" BorderThickness="1" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource IconButton}" Width="26" Height="26" Margin="4,0,0,0" Click="ConnectionInfo_Click" ToolTip="Informații despre conexiune" AutomationProperties.Name="Informații despre conexiune"><TextBlock x:Name="SecurityGlyph" Text="&#xE72E;"
                                   FontFamily="{StaticResource IconFont}" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                   ToolTip="Conexiune securizată" /></Button>

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="OmniboxPlaceholder" Text="Caută sau introdu o adresă"
                                       Foreground="{DynamicResource TextMuted}" FontSize="13.5"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Margin="4,0,0,0" />
                            <TextBox x:Name="Omnibox" Style="{StaticResource OmniboxBox}"
                                     Margin="0" Padding="4,0,0,0"
                                     PreviewKeyDown="Omnibox_KeyDown"
                                     GotKeyboardFocus="Omnibox_GotFocus"
                                     LostKeyboardFocus="Omnibox_LostFocus"
                                     TextChanged="Omnibox_TextChanged" ContextMenuOpening="Omnibox_ContextMenuOpening"><TextBox.ContextMenu><ContextMenu /></TextBox.ContextMenu></TextBox>
                        </Grid>

                        <Button x:Name="BookmarkButton" Grid.Column="2" Style="{StaticResource IconButton}"
                                Content="&#xE734;" Width="26" Height="26" FontSize="12"
                                Margin="2,0,2,0" ToolTip="Adaugă la favorite (Ctrl+D)" Click="Bookmark_Click" />

                        <Button x:Name="ShieldButton" Grid.Column="3" Style="{StaticResource IconButton}"
                                Content="&#xEA18;" Width="26" Height="26" FontSize="12"
                                Margin="0,0,4,0" ToolTip="Scut Vela" Click="Shield_Click" />
                    </Grid>
                </Border>

                <!-- right cluster -->
                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="DownloadsButton" Style="{StaticResource IconButton}" Content="&#xE896;"
                            FontSize="13" ToolTip="Descărcări (Ctrl+J)" Click="Downloads_Click" />
                    <TextBlock x:Name="DownloadProgressText" Visibility="Collapsed" Foreground="{DynamicResource Accent}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="&#xE712;"
                            FontSize="14" ToolTip="Meniu" Click="Menu_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bookmarks bar: a compact strip under the omnibox, hidden on request. -->
        <Border x:Name="BookmarksBar" Visibility="Collapsed"
                Background="{DynamicResource WindowBg}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,1"
                Padding="6,2" AutomationProperties.Name="Bară de favorite">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="BookmarksBarEmpty" Grid.Column="0" Visibility="Collapsed"
                           Text="Favoritele apar aici — apasă Ctrl+D pe o pagină."
                           FontSize="11" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="8,0,0,0" />

                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                    <ItemsControl x:Name="BookmarksBarItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BookmarkBarButton}" Tag="{Binding Url}"
                                        Click="BookmarkBarItem_Click"
                                        ContextMenuOpening="BookmarkBarItem_ContextMenuOpening"
                                        ToolTip="{Binding Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                   Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Text" Value="&#xE8B7;" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Title}" MaxWidth="170"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Column="1" x:Name="BookmarksBarAllButton" Style="{StaticResource IconButton}"
                        Width="26" Height="24" FontSize="12" Content="&#xE712;"
                        Margin="4,0,0,0" ToolTip="Toate favoritele"
                        Click="BookmarksBarAll_Click" />
            </Grid>
        </Border>
        </StackPanel>

        <!-- ================= CONTENT ================= -->
        <Border x:Name="PermissionBar" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource ToolbarBg}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,1" Padding="14,10" PreviewKeyDown="PermissionBar_KeyDown" AutomationProperties.Name="Permisiune solicitată de site">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock x:Name="PermissionOrigin" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="PermissionDescription" Foreground="{DynamicResource TextPrimary}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <TextBlock x:Name="PermissionHint" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="PermissionDeny" Content="Blochează" Tag="deny" Click="PermissionChoice_Click" Style="{StaticResource SettingsButton}" Margin="0,0,8,0" />
                    <Button x:Name="PermissionAllow" Content="Permite" Tag="allow" Click="PermissionChoice_Click" Style="{StaticResource SettingsButton}" Margin="0,0,8,0" />
                    <Button x:Name="PermissionDismiss" Content="Nu acum" Tag="dismiss" Click="PermissionChoice_Click" Style="{StaticResource SettingsButton}" />
                </WrapPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="3" x:Name="ContentHost" Background="{DynamicResource ContentBg}" />

        <!-- ================= STATUS BAR ================= -->
        <Border Grid.Row="4" Background="{DynamicResource WindowBg}" Padding="10,0">
            <Grid>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MemoryText" FontSize="11" Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Popup x:Name="SuggestionsPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=OmniboxBorder}" VerticalOffset="4">
            <Border Style="{StaticResource PopupSurface}" Padding="5"
                    Width="{Binding ActualWidth, ElementName=OmniboxBorder}">
                <ListBox x:Name="SuggestionsList" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="420">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" CornerRadius="6" Padding="10,7" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBg}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBg}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent" PreviewMouseLeftButtonDown="Suggestion_MouseDown" Cursor="Hand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Url}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Source}" FontSize="10"
                                           Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>

        <!-- ================= MENU POPUP ================= -->
        <Popup x:Name="MenuPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade"
               PlacementTarget="{Binding ElementName=MenuButton}" HorizontalOffset="-268">
            <Border Style="{StaticResource PopupSurface}" Width="300" Margin="6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <Button Style="{StaticResource MenuRowButton}" Click="MenuNewTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" Width="22" />
                                <TextBlock Text="Tab nou" />
                                <TextBlock Text="Ctrl+T" Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MenuRowButton}" Click="MenuNewWindow_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" Width="22" />
                                <TextBlock Text="Fereastră nouă" />
                                <TextBlock Text="Ctrl+N" Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MenuRowButton}" Click="MenuSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" Width="22" />
                                <TextBlock Text="Setări" />
                                <TextBlock Text="Ctrl+," Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MenuRowButton}" Click="PrivateWindow_Click"><DockPanel Width="300"><TextBlock DockPanel.Dock="Right" Text="Ctrl+Shift+N" Foreground="{DynamicResource TextMuted}" /><TextBlock Text="Fereastră privată" /></DockPanel></Button>
                        <Button Style="{StaticResource MenuRowButton}" Click="Find_Click">
                            <DockPanel Width="260">
                                <TextBlock DockPanel.Dock="Right" Text="Ctrl+F" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="Caută în pagină" />
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource MenuRowButton}" Click="Downloads_Click">
                            <DockPanel Width="260">
                                <TextBlock DockPanel.Dock="Right" Text="Ctrl+J" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="Descărcări" />
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource MenuRowButton}" Content="Permisiuni și date pe site" Click="SiteSettings_Click" />
                        <Button Style="{StaticResource MenuRowButton}" Content="Bibliotecă — istoric, favorite, taburi" Tag="bookmarks" Click="Library_Click" />
                        <CheckBox x:Name="BookmarksBarToggle" Style="{StaticResource SettingsSwitch}"
                                  Margin="10,6,10,8" Click="BookmarksBarToggle_Click">
                            <TextBlock Text="Bară de favorite (Ctrl+Shift+B)" />
                        </CheckBox>
                        <Button Style="{StaticResource MenuRowButton}" Content="Profiluri, import și grupuri…" Tag="profiles" Click="Workspace_Click" />
                        <Button Style="{StaticResource MenuRowButton}" Content="Consum pe procese…" Tag="resources" Click="Workspace_Click" />
                        <Button Style="{StaticResource MenuRowButton}" Content="Citește mai târziu" Tag="reading" Click="Library_Click" />
                        <Button Style="{StaticResource MenuRowButton}" Click="Print_Click"><DockPanel Width="300"><TextBlock DockPanel.Dock="Right" Text="Ctrl+P" Foreground="{DynamicResource TextMuted}" /><TextBlock Text="Imprimă…" /></DockPanel></Button>
                        <Button Style="{StaticResource MenuRowButton}" Click="SavePdf_Click"><DockPanel Width="300"><TextBlock DockPanel.Dock="Right" Text="Ctrl+Shift+S" Foreground="{DynamicResource TextMuted}" /><TextBlock Text="Salvează PDF…" /></DockPanel></Button>
                        <Button Style="{StaticResource MenuRowButton}" Content="Mod de citire" Click="Reader_Click" />
                        <Button Style="{StaticResource MenuRowButton}" Content="Picture-in-Picture" Click="PictureInPicture_Click" />
                        <Button Style="{StaticResource MenuRowButton}" Content="Tradu pagina cu Google Translate…" Click="Translate_Click" />

                        <Separator Background="{DynamicResource BorderSoft}" Margin="6,6" Height="1" />

                        <TextBlock Text="FAVORITE" Style="{StaticResource MenuHeaderText}" />
                        <ItemsControl x:Name="BookmarksList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MenuRowButton}" Click="BookmarkItem_Click" Tag="{Binding Url}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                       Foreground="{DynamicResource Accent}" Width="22" />
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="230" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoBookmarksText" Text="Nicio favorită încă — Ctrl+D pe o pagină."
                                   FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="10,2,10,6"
                                   TextWrapping="Wrap" Visibility="Collapsed" />

                        <Separator Background="{DynamicResource BorderSoft}" Margin="6,6" Height="1" />

                        <TextBlock Text="ISTORIC RECENT" Style="{StaticResource MenuHeaderText}" />
                        <ItemsControl x:Name="HistoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MenuRowButton}" Click="HistoryItem_Click" Tag="{Binding Url}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                                            <TextBlock Text="{Binding Url}" FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="250" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="{DynamicResource BorderSoft}" Margin="6,6" Height="1" />

                        <TextBlock Text="ECONOMIE DE MEMORIE" Style="{StaticResource MenuHeaderText}" />
                        <TextBlock x:Name="SleepPolicyText" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   Margin="10,0,10,6" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,4">
                            <Button Style="{StaticResource MenuRowButton}" Content="1 min" Tag="1" Click="SleepPolicy_Click" />
                            <Button Style="{StaticResource MenuRowButton}" Content="5 min" Tag="5" Click="SleepPolicy_Click" />
                            <Button Style="{StaticResource MenuRowButton}" Content="15 min" Tag="15" Click="SleepPolicy_Click" />
                            <Button Style="{StaticResource MenuRowButton}" Content="Oprit" Tag="0" Click="SleepPolicy_Click" />
                        </StackPanel>
                        <CheckBox x:Name="ProtectSiteToggle" Style="{StaticResource SettingsSwitch}"
                                  Margin="10,6,10,8" Click="ProtectSite_Click">
                            <TextBlock x:Name="ProtectSiteLabel" Text="Nu adormi acest site" MaxWidth="205" TextTrimming="CharacterEllipsis" />
                        </CheckBox>
                        <ItemsControl x:Name="ProtectedSitesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MenuRowButton}" Tag="{Binding}" Click="UnprotectSite_Click"
                                            ToolTip="Elimină excepția de adormire">
                                        <Grid Width="250">
                                            <TextBlock Text="{Binding}" Margin="0,0,24,0" TextTrimming="CharacterEllipsis" FontSize="11" />
                                            <TextBlock Text="×" HorizontalAlignment="Right" Foreground="{DynamicResource TextMuted}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="{DynamicResource BorderSoft}" Margin="6,6" Height="1" />

                        <Button Style="{StaticResource MenuRowButton}" Click="MenuClearData_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" Width="22" />
                                <TextBlock Text="Șterge istoricul" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MenuRowButton}" Click="MenuAbout_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" Width="22" />
                                <TextBlock Text="Despre Vela" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- ================= DOWNLOADS PANEL ================= -->
        <Popup x:Name="DownloadsPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade"
               PlacementTarget="{Binding ElementName=DownloadsButton}" HorizontalOffset="-318">
            <Border Style="{StaticResource PopupSurface}" Width="370" Margin="6" Padding="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Descărcări" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="DownloadsCountText" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       Margin="8,2,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="DownloadsFolderButton" Content="&#xE838;" Style="{StaticResource IconButton}"
                                    Width="24" Height="24" FontSize="11" ToolTip="Deschide folderul descărcărilor"
                                    Margin="0,0,4,0" Click="DownloadsFolder_Click" />
                            <Button x:Name="DownloadsClearButton" Content="Golește" Style="{StaticResource MenuRowButton}"
                                    Padding="8,4" FontSize="11.5"
                                    Foreground="{DynamicResource TextSecondary}" Click="DownloadsClear_Click"
                                    ToolTip="Elimină descărcările finalizate din listă" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <TextBlock x:Name="DownloadsEmpty" Text="Nicio descărcare încă. Fișierele salvate apar aici."
                                   FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                   Margin="2,2,2,8" />
                        <ScrollViewer x:Name="DownloadsScroll" MaxHeight="380" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DownloadsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource InsetBg}" CornerRadius="8"
                                                Padding="10" Margin="0,0,2,7">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="14" Foreground="{DynamicResource TextSecondary}"
                                                               Margin="0,0,9,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" MaxWidth="176"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               ToolTip="{Binding FilePath}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="&#xE8E5;" Style="{StaticResource IconButton}"
                                                            Width="24" Height="24" FontSize="11" ToolTip="Deschide fișierul"
                                                            Visibility="{Binding OpenVisibility}"
                                                            Tag="{Binding}" Click="DownloadOpen_Click" />
                                                    <Button Content="&#xE838;" Style="{StaticResource IconButton}"
                                                            Width="24" Height="24" FontSize="11" ToolTip="Arată în folder"
                                                            Visibility="{Binding RevealVisibility}"
                                                            Tag="{Binding}" Click="DownloadReveal_Click" />
                                                    <Button Content="&#xE769;" Style="{StaticResource IconButton}"
                                                            Width="24" Height="24" FontSize="11" ToolTip="Pauză"
                                                            Visibility="{Binding PauseVisibility}"
                                                            Tag="{Binding}" Click="DownloadPause_Click" />
                                                    <Button Content="&#xE768;" Style="{StaticResource IconButton}"
                                                            Width="24" Height="24" FontSize="11" ToolTip="Reia"
                                                            Visibility="{Binding ResumeVisibility}"
                                                            Tag="{Binding}" Click="DownloadResume_Click" />
                                                    <Button Content="&#xE711;" Style="{StaticResource IconButton}"
                                                            Width="24" Height="24" FontSize="11" ToolTip="Anulează"
                                                            Visibility="{Binding CancelVisibility}"
                                                            Tag="{Binding}" Click="DownloadCancel_Click" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="23,5,0,0">
                                                    <ProgressBar Style="{StaticResource DownloadProgressBar}"
                                                                 Value="{Binding Progress, Mode=OneWay}" Height="3"
                                                                 Visibility="{Binding ProgressVisibility}" />
                                                    <TextBlock Text="{Binding DetailText}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextMuted}" Margin="0,5,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Popup>

        <!-- ================= SHIELD POPUP ================= -->
        <Popup x:Name="ShieldPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade"
               PlacementTarget="{Binding ElementName=ShieldButton}" HorizontalOffset="-236">
            <Border Style="{StaticResource PopupSurface}" Width="268" Margin="6" Padding="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Scut Vela" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2" />
                    <TextBlock x:Name="ShieldHostText" FontSize="11" Foreground="{DynamicResource TextMuted}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />
                    <CheckBox x:Name="ShieldToggle" Foreground="{DynamicResource TextPrimary}"
                              Content="Blochează reclame și trackere"
                              Click="ShieldToggle_Click" Margin="0,0,0,10" />
                    <Border Background="{DynamicResource InsetBg}" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock x:Name="ShieldBlockedText" Text="0 cereri blocate" FontSize="12" />
                            <TextBlock x:Name="ShieldSavedText" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       Margin="0,3,0,0" Text="Se aplică doar acestui site." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
