<Window x:Class="Vela.SiteSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Permisiuni și date pe site — Vela" Icon="Assets/vela.ico"
        Width="880" Height="650" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Permisiuni și date pe site" Style="{StaticResource SettingsPageTitle}" />
        <Grid Grid.Row="1" Margin="0,16,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="OriginBox" Style="{StaticResource SettingsInput}" AutomationProperties.Name="Adresa site-ului" KeyDown="Origin_KeyDown" />
            <Button Grid.Column="1" Content="Deschide" Style="{StaticResource SettingsButton}" Margin="10,0,0,0" Click="LoadOrigin_Click" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="SITE-URI CU PERMISIUNI SALVATE" Style="{StaticResource MenuHeaderText}" TextWrapping="Wrap" />
                    <ItemsControl x:Name="OriginsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MenuRowButton}" Click="SelectOrigin_Click" Tag="{Binding}" ToolTip="{Binding}">
                                    <TextBlock Text="{Binding}" Width="175" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="SelectedOriginText" Text="Alege sau introdu un site." Style="{StaticResource SettingsTitle}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <ItemsControl x:Name="PermissionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Name}" FontSize="13" Margin="0,0,0,6" />
                                    <WrapPanel>
                                        <RadioButton Content="Întreabă" Style="{StaticResource ChoiceChip}" GroupName="{Binding Group}" IsChecked="{Binding Ask, Mode=OneWay}" Tag="Default" Click="Permission_Click" />
                                        <RadioButton Content="Permite" Style="{StaticResource ChoiceChip}" GroupName="{Binding Group}" IsChecked="{Binding Allow, Mode=OneWay}" Tag="Allow" Click="Permission_Click" />
                                        <RadioButton Content="Blochează" Style="{StaticResource ChoiceChip}" GroupName="{Binding Group}" IsChecked="{Binding Deny, Mode=OneWay}" Tag="Deny" Click="Permission_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource SettingsCard}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Datele site-ului" Style="{StaticResource SettingsTitle}" />
                            <TextBlock Text="Șterge cookie-urile și stocarea site-ului ales. Poți fi deconectat de pe acest site. Cookie-urile partajate pot afecta și subdomeniile sale. Permisiunile și favoritele se păstrează."
                                       Style="{StaticResource SettingsHint}" Margin="0,8,0,12" />
                            <Button x:Name="ClearDataButton" Content="Șterge datele acestui site…" Style="{StaticResource SettingsButton}"
                                    HorizontalAlignment="Left" Click="ClearData_Click" IsEnabled="False" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0" />
            <Button Grid.Column="1" Content="Închide" Style="{StaticResource SettingsButton}" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
