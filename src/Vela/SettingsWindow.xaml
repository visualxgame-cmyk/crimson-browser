<Window x:Class="Vela.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Setări — Vela"
        Icon="Assets/vela.ico"
        Width="1010" Height="730" MinWidth="900" MinHeight="620"
        WindowStyle="None" AllowsTransparency="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= TITLE BAR ================= -->
            <Grid Grid.Row="0" Background="{DynamicResource WindowBg}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Accent}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="Setări" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"
                        ToolTip="Închide" Click="Close_Click" />
            </Grid>

            <!-- ================= BODY ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="238" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource ToolbarBg}"
                        BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,1,0">
                    <Grid Margin="12,18,12,14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel VerticalAlignment="Top">
                            <RadioButton x:Name="AspectNav" Style="{StaticResource SettingsNav}"
                                         GroupName="nav" Tag="aspect" IsChecked="True"
                                         Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}"
                                               FontSize="12" Width="20" />
                                    <TextBlock Text="Aspect" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SettingsNav}" GroupName="nav"
                                         Tag="newtab" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}"
                                               FontSize="12" Width="20" />
                                    <TextBlock Text="Tab nou" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SettingsNav}" GroupName="nav"
                                         Tag="memory" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFont}"
                                               FontSize="12" Width="20" />
                                    <TextBlock Text="Memorie" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SettingsNav}" GroupName="nav"
                                         Tag="privacy" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}"
                                               FontSize="12" Width="20" />
                                    <TextBlock Text="Confidențialitate" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SettingsNav}" GroupName="nav"
                                         Tag="navigation" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}"
                                               FontSize="12" Width="20" />
                                    <TextBlock Text="Navigare" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel></ScrollViewer>
                    </Grid>
                </Border>

                <!-- pages -->
                <Grid Grid.Column="1" Background="{DynamicResource WindowBg}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="32,26,30,10">
                        <Grid MaxWidth="720" HorizontalAlignment="Left">

                            <!-- ============ ASPECT ============ -->
                            <StackPanel x:Name="AspectPage">
                                <TextBlock Text="Aspect" Style="{StaticResource SettingsPageTitle}" Margin="0,0,0,20" />

                                <TextBlock Text="TEMĂ" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}" />
                                <WrapPanel x:Name="ThemePanel" Margin="0,8,0,10" />

                                <Border Style="{StaticResource SettingsCard}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Accent personalizat" Style="{StaticResource SettingsTitle}" Margin="0,0,0,14" />
                                        <WrapPanel x:Name="AccentPanel" Margin="0,0,0,10" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="AccentHexBox" Style="{StaticResource SettingsInput}"
                                                     Width="130" KeyDown="AccentHex_KeyDown" />
                                            <Button Content="Aplică" Style="{StaticResource SettingsButton}"
                                                    Margin="8,0,0,0" Click="AccentApply_Click" />
                                            <Button Content="Folosește tema" Style="{StaticResource SettingsButton}"
                                                    Margin="8,0,0,0" Click="AccentAuto_Click" />
                                        </StackPanel>
                                        <TextBlock x:Name="AccentStatusText" Style="{StaticResource SettingsHint}"
                                                   Margin="0,8,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============ TAB NOU ============ -->
                            <StackPanel x:Name="NewTabPage" Visibility="Collapsed">
                                <TextBlock Text="Tab nou" Style="{StaticResource SettingsPageTitle}" Margin="0,0,0,20" />

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Fundal" Style="{StaticResource SettingsTitle}" Margin="0,0,0,12" />

                                        <WrapPanel>
                                            <RadioButton x:Name="BgThemeChip" Style="{StaticResource ChoiceChip}"
                                                         GroupName="bgmode" Tag="theme" Content="Tema"
                                                         Checked="BgMode_Checked" />
                                            <RadioButton x:Name="BgColorChip" Style="{StaticResource ChoiceChip}"
                                                         GroupName="bgmode" Tag="color" Content="Culoare simplă"
                                                         Checked="BgMode_Checked" />
                                            <RadioButton x:Name="BgImageChip" Style="{StaticResource ChoiceChip}"
                                                         GroupName="bgmode" Tag="image" Content="Imagine"
                                                         Checked="BgMode_Checked" />
                                        </WrapPanel>

                                        <!-- colour -->
                                        <Border Background="{DynamicResource InsetBg}" CornerRadius="10"
                                                Padding="14" Margin="0,4,0,10">
                                            <StackPanel>
                                                <TextBlock Text="CULOARE" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMuted}" />
                                                <WrapPanel x:Name="ColorPanel" Margin="0,8,0,4" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox x:Name="ColorHexBox" Style="{StaticResource SettingsInput}"
                                                             Width="130" KeyDown="ColorHex_KeyDown" />
                                                    <Button Content="Aplică" Style="{StaticResource SettingsButton}"
                                                            Margin="8,0,0,0" Click="ColorApply_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- image -->
                                        <Border Background="{DynamicResource InsetBg}" CornerRadius="10"
                                                Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="IMAGINE" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Alege imaginea…" Style="{StaticResource SettingsButton}"
                                                            Click="PickImage_Click" />
                                                    <Button x:Name="RemoveImageButton" Content="Elimină"
                                                            Style="{StaticResource SettingsButton}"
                                                            Margin="8,0,0,0" Click="RemoveImage_Click" />
                                                </StackPanel>
                                                <TextBlock x:Name="ImageNameText" Style="{StaticResource SettingsHint}"
                                                           Margin="0,10,0,0" Text="" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                                        CornerRadius="12" ClipToBounds="True" Height="172" Margin="0,16,0,0">
                                    <Grid>
                                        <Border x:Name="BgPreviewColor" Background="{DynamicResource ContentBg}" />
                                        <Border x:Name="BgPreviewImage" Visibility="Collapsed">
                                            <Border.Background>
                                                <ImageBrush Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <Border Background="#66000000" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="vela" FontSize="26" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <Border Width="220" Height="30" CornerRadius="9" Margin="0,10,0,0"
                                                    Background="#33FFFFFF" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- ============ MEMORIE ============ -->
                            <StackPanel x:Name="MemoryPage" Visibility="Collapsed">
                                <TextBlock Text="Memorie" Style="{StaticResource SettingsPageTitle}" Margin="0,0,0,20" />
                                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12"><StackPanel>
                                    <CheckBox x:Name="EconomyToggle" Content="Mod Economie" Style="{StaticResource SettingsSwitch}" />
                                    <TextBlock Text="Țintă: 3 pagini încărcate, adormire după 1 minut și eliberare după 5 minute. Editările, apelurile, media, descărcările și protecțiile de închidere pot depăși limita. Dezactivarea restabilește valorile tale de mai jos." Style="{StaticResource SettingsHint}" Margin="0,10,0,0" />
                                </StackPanel></Border>

                                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Adormire tab-uri din fundal" Style="{StaticResource SettingsTitle}" Margin="0,0,0,12" />
                                        <WrapPanel x:Name="SuspendPanel" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Eliberare completă" Style="{StaticResource SettingsTitle}" Margin="0,0,0,12" />
                                        <WrapPanel x:Name="DiscardPanel" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Tab-uri încărcate simultan" Style="{StaticResource SettingsTitle}" Margin="0,0,0,12" />
                                        <WrapPanel x:Name="MaxLivePanel" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ============ CONFIDENȚIALITATE ============ -->
                            <StackPanel x:Name="PrivacyPage" Visibility="Collapsed">
                                <TextBlock Text="Confidențialitate" Style="{StaticResource SettingsPageTitle}" Margin="0,0,0,20" />

                                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <CheckBox x:Name="BlockAdsSwitch" Style="{StaticResource SettingsSwitch}"
                                                  Content="Blochează reclame și trackere" Click="BlockAds_Click" />
                                        <Button Content="Deschide folderul Filters" Style="{StaticResource SettingsButton}"
                                                HorizontalAlignment="Left" Margin="0,14,0,0" Click="OpenFilters_Click" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <CheckBox x:Name="RestoreSwitch" Style="{StaticResource SettingsSwitch}"
                                                  Content="Redeschide tab-urile de la ultima sesiune" Click="Restore_Click" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCard}" Margin="0,12,0,0"><StackPanel>
                                    <TextBlock Text="Parole și completare automată" Style="{StaticResource SettingsTitle}" Margin="0,0,0,12" />
                                    <CheckBox x:Name="SavePasswordsToggle" Content="Oferă salvarea parolelor noi" Style="{StaticResource SettingsSwitch}" Margin="0,0,0,12" />
                                    <CheckBox x:Name="AutofillToggle" Content="Completează automat datele generale" Style="{StaticResource SettingsSwitch}" Margin="0,0,0,12" />
                                    <TextBlock Text="Datele sunt administrate de motorul WebView2. Dezactivarea salvării parolelor noi nu șterge parolele existente. Listarea individuală a parolelor nu este disponibilă prin API-ul motorului." Style="{StaticResource SettingsHint}" Margin="0,0,0,12" />
                                    <WrapPanel><Button Content="Șterge parolele salvate…" Tag="clear-passwords" Style="{StaticResource SettingsButton}" Click="Tool_Click" Margin="0,0,8,8" /><Button Content="Șterge completarea automată…" Tag="clear-autofill" Style="{StaticResource SettingsButton}" Click="Tool_Click" Margin="0,0,0,8" /></WrapPanel>
                                </StackPanel></Border>
                                <Button Content="Deschide biblioteca de date și protecție" Tag="library" Style="{StaticResource SettingsButton}" Click="Tool_Click" Margin="0,14,0,0" HorizontalAlignment="Left" />
                            </StackPanel>

                            <!-- ============ NAVIGARE ============ -->
                            <StackPanel x:Name="NavPage" Visibility="Collapsed">
                                <TextBlock Text="Navigare" Style="{StaticResource SettingsPageTitle}" Margin="0,0,0,20" />
                                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12"><StackPanel>
                                    <TextBlock Text="La pornire" Style="{StaticResource SettingsTitle}" Margin="0,0,0,12" />
                                    <WrapPanel><RadioButton x:Name="StartupRestore" Content="Ultima sesiune" GroupName="startup" Tag="restore" Style="{StaticResource ChoiceChip}" Checked="Startup_Checked" /><RadioButton x:Name="StartupHome" Content="Pagina principală" GroupName="startup" Tag="home" Style="{StaticResource ChoiceChip}" Checked="Startup_Checked" /><RadioButton x:Name="StartupNewTab" Content="Tab nou" GroupName="startup" Tag="newtab" Style="{StaticResource ChoiceChip}" Checked="Startup_Checked" /></WrapPanel>
                                </StackPanel></Border>

                                <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Pagina de start" Style="{StaticResource SettingsTitle}" Margin="0,0,0,10" />
                                        <TextBox x:Name="HomePageBox" Style="{StaticResource SettingsInput}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Motor de căutare" Style="{StaticResource SettingsTitle}" Margin="0,0,0,10" />
                                        <ComboBox x:Name="SearchEnginePreset" SelectionChanged="SearchEngine_Changed" Margin="0,0,0,10" AutomationProperties.Name="Motor de căutare">
                                            <ComboBoxItem Content="DuckDuckGo" Tag="https://duckduckgo.com/?q=" /><ComboBoxItem Content="Google" Tag="https://www.google.com/search?q=" /><ComboBoxItem Content="Bing" Tag="https://www.bing.com/search?q=" /><ComboBoxItem Content="Brave Search" Tag="https://search.brave.com/search?q=" /><ComboBoxItem Content="Personalizat" />
                                        </ComboBox>
                                        <TextBox x:Name="SearchUrlBox" Style="{StaticResource SettingsInput}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCard}" Margin="0,12,0,0"><StackPanel>
                                    <TextBlock Text="Descărcări" Style="{StaticResource SettingsTitle}" Margin="0,0,0,12" />
                                    <TextBox x:Name="DownloadFolderBox" Style="{StaticResource SettingsInput}" AutomationProperties.Name="Folderul descărcărilor" />
                                    <Button Content="Alege folderul…" Style="{StaticResource SettingsButton}" Click="DownloadFolder_Click" HorizontalAlignment="Left" Margin="0,10,0,12" />
                                    <CheckBox x:Name="AskDownloadToggle" Content="Întreabă unde se salvează fiecare fișier" Style="{StaticResource SettingsSwitch}" />
                                </StackPanel></Border>
                                <Border Style="{StaticResource SettingsCard}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Favorite și site-uri" Style="{StaticResource SettingsTitle}" />
                                        <TextBlock Text="Importul păstrează favoritele existente. Aceste acțiuni se aplică imediat." Style="{StaticResource SettingsHint}" Margin="0,8,0,12" />
                                        <WrapPanel>
                                            <Button Content="Importă HTML…" Tag="import" Style="{StaticResource SettingsButton}" Click="Tool_Click" Margin="0,0,8,8" />
                                            <Button Content="Exportă HTML…" Tag="export" Style="{StaticResource SettingsButton}" Click="Tool_Click" Margin="0,0,8,8" />
                                            <Button Content="Permisiuni și date pe site" Tag="permissions" Style="{StaticResource SettingsButton}" Click="Tool_Click" Margin="0,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCard}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Browser implicit" Style="{StaticResource SettingsTitle}" />
                                        <TextBlock Text="Înregistrează Vela pentru linkuri HTTP/HTTPS și fișiere HTML, apoi deschide alegerea aplicației implicite din Windows." Style="{StaticResource SettingsHint}" Margin="0,8,0,12" />
                                        <Button Content="Alege Vela în Windows…" Style="{StaticResource SettingsButton}" Click="DefaultBrowser_Click" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCard}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Actualizări" Style="{StaticResource SettingsTitle}" />
                                        <TextBlock Text="GitHub Releases găzduiește gratuit versiunile publice. Verificarea pornește doar la apăsarea butonului; nu există serviciu de actualizare în fundal." Style="{StaticResource SettingsHint}" Margin="0,8,0,12" />
                                        <TextBlock Text="Repository public GitHub (utilizator/repository)" Style="{StaticResource SettingsHint}" Margin="0,0,0,6" />
                                        <TextBox x:Name="UpdateRepositoryBox" Style="{StaticResource SettingsInput}" AutomationProperties.Name="Repository GitHub pentru actualizări" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button x:Name="CheckUpdatesButton" Content="Verifică acum" Style="{StaticResource SettingsButton}" Click="CheckUpdates_Click" Margin="0,0,8,8" />
                                            <Button x:Name="OpenReleaseButton" Content="Deschide pagina versiunii" Style="{StaticResource SettingsButton}" Click="OpenRelease_Click" Visibility="Collapsed" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingsHint}" Text="Verificarea GitHub pornește numai la cerere." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- footer -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0"
                            Padding="32,14,30,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="FooterStatusText" VerticalAlignment="Center" FontSize="11.5"
                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Anulează" Style="{StaticResource SettingsButton}"
                                        Click="Cancel_Click" />
                                <Button Content="Salvează" Style="{StaticResource SettingsPrimaryButton}"
                                        Margin="10,0,0,0" Click="Save_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
