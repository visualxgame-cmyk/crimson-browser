<Window x:Class="Vela.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vela"
        Icon="Assets/vela.ico"
        Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Rounded browser card with its own shadow: the dialog follows the palette and never
         looks like a native Windows message box. -->
    <Border x:Name="Card" Margin="18"
            Background="{DynamicResource PopupBg}"
            BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="22,18"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="8" Height="8" CornerRadius="4"
                        Background="{DynamicResource Accent}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Margin="10,0,0,0"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,14,0,0"
                       FontSize="13" LineHeight="20" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimary}" />

            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="SecondaryButton" Style="{StaticResource SettingsButton}"
                        MinWidth="96" Margin="0,0,8,0"
                        IsCancel="True" Click="Secondary_Click" />
                <Button x:Name="PrimaryButton" Style="{StaticResource SettingsPrimaryButton}"
                        MinWidth="96"
                        IsDefault="True" Click="Primary_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
