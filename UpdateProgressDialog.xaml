<Window x:Class="CrimsonBrowser.UpdateProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CrimsonBrowser.Services"
        Title="{loc:Loc AppTitle}"
        Width="430" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextWhiteBrush}">

    <Border Background="#161720" BorderBrush="{StaticResource CrimsonDarkRedBrush}" BorderThickness="1.5"
            CornerRadius="16" Padding="24" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="10" Color="#000000" Opacity="0.9" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0 0 0 14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#251219"
                        BorderBrush="{StaticResource CrimsonDarkRedBrush}" BorderThickness="1"
                        VerticalAlignment="Center" Margin="0 0 12 0">
                    <Path Width="18" Height="18" Fill="{StaticResource CrimsonRedGlowBrush}"
                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M9 0 L18 4 C18 12 14 17 9 18 C4 17 0 12 0 4 Z" />
                </Border>

                <TextBlock Grid.Column="1" x:Name="TitleText" Text="{loc:Loc UpdateProgressTitle}"
                           FontSize="15" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>

            <TextBlock Grid.Row="1" x:Name="MessageText" Text="{loc:Loc UpdateProgressMessage}"
                       Foreground="#C9CCD8" FontSize="12.5" TextWrapping="Wrap"
                       LineHeight="19" Margin="2 0 2 16" />

            <Grid Grid.Row="2" Margin="2 0 2 14">
                <ProgressBar x:Name="UpdateProgress" Height="8" Minimum="0" Maximum="1" Value="0"
                             Background="#252736" BorderThickness="0"
                             Foreground="{StaticResource CrimsonRedGlowBrush}" />
                <TextBlock x:Name="ProgressText" Text="0%" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0 0 8 0"
                           FontSize="9.5" FontWeight="Bold" Foreground="White" />
            </Grid>

            <TextBlock Grid.Row="3" x:Name="NoteText" Text="{loc:Loc UpdateProgressNote}"
                       Foreground="#777B8E" FontSize="11" TextWrapping="Wrap" Margin="2 0 2 0" />
        </Grid>
    </Border>
</Window>
